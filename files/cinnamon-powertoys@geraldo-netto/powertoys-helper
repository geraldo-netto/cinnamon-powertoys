#!/bin/sh
#
# cinnamon-powertoys privileged helper.
#
# Applies the power settings that are owned by root. Every value is checked
# against what the kernel itself advertises, so the applet (or anything else
# calling this through pkexec) cannot write arbitrary data into /sys.
#
# Usage:
#   powertoys-helper governor <name>
#   powertoys-helper epp <name>
#   powertoys-helper boost <0|1>
#   powertoys-helper platform-profile <name>
#   powertoys-helper charge-threshold <20-100>

set -eu

CPU_DIR=/sys/devices/system/cpu
CPUFREQ_DIR=$CPU_DIR/cpufreq
POWER_SUPPLY_DIR=/sys/class/power_supply
PLATFORM_PROFILE=/sys/firmware/acpi/platform_profile
PLATFORM_PROFILE_CHOICES=/sys/firmware/acpi/platform_profile_choices
LOCK_FILE=/run/cinnamon-powertoys-helper.lock
PROTOCOL_VERSION=2

die() {
    code=$1
    shift
    printf 'powertoys-helper-error %s %s\n' "$code" "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage:
  powertoys-helper governor <name>
  powertoys-helper epp <name>
  powertoys-helper boost <0|1>
  powertoys-helper platform-profile <name>
  powertoys-helper charge-threshold <20-100>

Every value is checked against the list the kernel advertises before it is
written. Run through pkexec, the settings are owned by root.
EOF
    echo "powertoys-helper-error invalid-invocation invalid command line" >&2
    exit 2
}

contains() {
    needle=$1
    shift
    for word in "$@"; do
        if [ "$word" = "$needle" ]; then
            return 0
        fi
    done
    return 1
}

# advertises <value> <the kernel's list, as one string>
#
# The list arrives as one string and has to be split into words, which means an
# unquoted expansion - and that invites pathname expansion as well, so a list
# carrying a `*` would match a filename in the caller's working directory
# rather than something the kernel offered. pkexec does not chdir, so that
# directory is the caller's. Globbing is off for the split alone.
advertises() {
    advertises_needle=$1
    advertises_list=$2
    set -f
    # shellcheck disable=SC2086
    if contains "$advertises_needle" $advertises_list; then
        advertises_status=0
    else
        advertises_status=1
    fi
    set +f
    return "$advertises_status"
}

# plan_append <plan> <node> <old> <new>
#
# One record per line, tab separated, in the order they will be applied. The
# plan is a string rather than a file because it never leaves this process and
# apply_transaction reads it the same way.
plan_append() {
    plan_existing=$1
    plan_record="$2	$3	$4"
    printf '%s' "${plan_existing:+$plan_existing
}$plan_record"
}

# Hold one machine-wide transaction boundary. /run is root-owned, so an
# unprivileged caller cannot redirect this fixed path before pkexec starts.
acquire_lock() {
    command -v flock >/dev/null 2>&1 ||
        die unavailable "the flock command required for safe writes is unavailable"
    if ! { exec 9>>"$LOCK_FILE"; } 2>/dev/null; then
        die unavailable "cannot open the privileged transaction lock"
    fi
    flock -x 9 || die unavailable "cannot acquire the privileged transaction lock"
}

# write_node <file> <value> <what to say if it will not take it>
#
# A redirect the kernel refuses ends this script under `set -e` with whatever
# the shell chose to say about it - not prefixed, not the same wording from one
# shell to the next, and on some of them not said at all. The applet reports
# the last line of stderr as the reason, so every way this script can fail has
# to be a line this script wrote.
# try_write is the one place anything here writes: the subshell keeps the
# shell's own message about a refused redirect quiet, so that every way this
# script can fail is a line this script wrote.
try_write() {
    write_target=$1
    write_value=$2
    ( printf '%s\n' "$write_value" > "$write_target" ) 2>/dev/null
}

write_node() {
    try_write "$1" "$2" || die write-failed "$3"
}

# apply_transaction <newline separated node<TAB>old<TAB>new records>
#
# The plan has already been completely validated. Remember successful writes
# in reverse order, restore them after the first refusal, and tell the caller
# whether that restoration itself completed.
apply_transaction() {
    transaction_plan=$1
    transaction_applied=
    transaction_failed=
    transaction_tab=$(printf '\t')
    while IFS="$transaction_tab" read -r transaction_node transaction_old transaction_new; do
        [ "$transaction_old" = "$transaction_new" ] && continue
        if try_write "$transaction_node" "$transaction_new"; then
            transaction_record="$transaction_node	$transaction_old"
            transaction_applied="$transaction_record${transaction_applied:+
$transaction_applied}"
        else
            transaction_failed=$transaction_node
            break
        fi
    done <<EOF
$transaction_plan
EOF

    [ -z "$transaction_failed" ] && return 0

    transaction_rollback_failed=
    if [ -n "$transaction_applied" ]; then
        while IFS="$transaction_tab" read -r transaction_node transaction_old; do
            if ! try_write "$transaction_node" "$transaction_old"; then
                transaction_rollback_failed="${transaction_rollback_failed}${transaction_rollback_failed:+, }$transaction_node"
            fi
        done <<EOF
$transaction_applied
EOF
    fi

    if [ -n "$transaction_rollback_failed" ]; then
        die rollback-failed "write refused: $transaction_failed; restoration refused: $transaction_rollback_failed"
    fi
    die change-failed-restored "write refused: $transaction_failed; previous settings restored"
}

# validate_policy_node <policy path> <node> <choices node> <value> <all|exposed>
#
# Whether this policy is a target, and if it is, what it holds now. Returns 1
# for a policy that simply does not expose the node under the `exposed` scope;
# every other disagreement is fatal here rather than at write time. Publishes
# `policy_old` for the caller's plan.
validate_policy_node() {
    validate_path=$1
    validate_node=$2
    validate_choices=$3
    validate_value=$4
    validate_scope=$5

    if [ ! -f "$validate_node" ]; then
        if [ "$validate_scope" = all ]; then
            die unsupported "cpufreq policy does not expose $policy_node_name: $validate_path"
        fi
        return 1
    fi
    [ -f "$validate_choices" ] ||
        die unsupported "cpufreq policy does not expose $policy_choices_name: $validate_path"
    if [ ! -r "$validate_node" ] || [ ! -w "$validate_node" ] || [ ! -r "$validate_choices" ]; then
        die unavailable "cpufreq policy is not readable and writable: $validate_path"
    fi

    policy_old=$(cat "$validate_node" 2>/dev/null || echo "")
    validate_available=$(cat "$validate_choices" 2>/dev/null || echo "")
    if [ -z "$policy_old" ] || [ -z "$validate_available" ]; then
        die unavailable "cpufreq policy did not answer: $validate_path"
    fi
    advertises "$validate_value" "$validate_available" ||
        die invalid-value "$policy_node_name=$validate_value is unavailable on $validate_path"
    return 0
}

# write_policies <node name> <choices node> <value> <all|exposed>
#
# Plan every policy first, then apply: a value one policy will not take must
# not leave the others changed.
write_policies() {
    policy_node_name=$1
    policy_choices_name=$2
    policy_value=$3
    policy_scope=$4
    policy_count=0
    policy_targets=0
    policy_plan=

    for policy_path in "$CPUFREQ_DIR"/policy*; do
        [ -d "$policy_path" ] || continue
        policy_count=$((policy_count + 1))
        policy_node="$policy_path/$policy_node_name"
        policy_choices="$policy_path/$policy_choices_name"

        validate_policy_node "$policy_path" "$policy_node" "$policy_choices" \
            "$policy_value" "$policy_scope" || continue

        policy_targets=$((policy_targets + 1))
        policy_plan=$(plan_append "$policy_plan" "$policy_node" "$policy_old" "$policy_value")
    done
    [ "$policy_count" -gt 0 ] || die unavailable "no cpufreq policy found"
    [ "$policy_targets" -gt 0 ] || die unsupported "no cpufreq policy exposes $policy_node_name"
    apply_transaction "$policy_plan"
}

set_governor() {
    write_policies scaling_governor scaling_available_governors "$1" all
}

set_energy_preference() {
    write_policies energy_performance_preference \
        energy_performance_available_preferences "$1" exposed
}

set_boost() {
    value=$1
    case "$value" in
        0|1) ;;
        *) die invalid-value "boost expects 0 or 1" ;;
    esac

    if [ -f "$CPUFREQ_DIR/boost" ]; then
        write_node "$CPUFREQ_DIR/boost" "$value" "the kernel would not set boost to $value"
    elif [ -f "$CPU_DIR/intel_pstate/no_turbo" ]; then
        # intel_pstate exposes the inverse switch
        if [ "$value" = "1" ]; then
            inverse=0
        else
            inverse=1
        fi
        write_node "$CPU_DIR/intel_pstate/no_turbo" "$inverse" \
            "the kernel would not set boost to $value"
    else
        die unsupported "this system does not expose a boost switch"
    fi
}

# The firmware profile, checked against the list the firmware publishes.
#
# A machine that cannot be asked is not a machine that refused: an absent,
# unreadable or empty choices node used to leave `choices` empty, which no
# value is a member of, so the caller was told the value it picked was invalid
# for this control. It was told to correct something that was never wrong,
# about a machine that had not answered. Each of the three now says what it is.
set_platform_profile() {
    value=$1
    [ -f "$PLATFORM_PROFILE" ] || die unsupported "no ACPI platform profile on this system"
    [ -f "$PLATFORM_PROFILE_CHOICES" ] ||
        die unsupported "this system does not publish the platform profiles it accepts"
    [ -r "$PLATFORM_PROFILE_CHOICES" ] ||
        die unavailable "the platform profile choices are not readable: $PLATFORM_PROFILE_CHOICES"
    choices=$(cat "$PLATFORM_PROFILE_CHOICES" 2>/dev/null || echo "")
    [ -n "$choices" ] ||
        die unavailable "the firmware did not say which platform profiles it accepts"
    advertises "$value" "$choices" || die invalid-value "unknown platform profile: $value"
    write_node "$PLATFORM_PROFILE" "$value" "the firmware would not take the profile: $value"
}

validate_threshold() {
    case "$1" in
        ''|*[!0-9]*) die invalid-value "charge threshold expects a number" ;;
    esac
    if [ "$1" -lt 20 ] || [ "$1" -gt 100 ]; then
        die invalid-value "charge threshold must be between 20 and 100"
    fi
}

is_battery() {
    battery_type_node="$1/type"
    [ -r "$battery_type_node" ] || return 1
    battery_type=$(cat "$battery_type_node" 2>/dev/null || echo "")
    [ "$battery_type" = Battery ]
}

# read_threshold <node> <what it is called>
#
# Publishes `threshold_value`. A threshold this script is about to change has
# to be readable, writable and numeric before anything is written, so that a
# rollback has somewhere to go back to. Publishes rather than prints: a `die`
# inside a command substitution would report from a subshell.
read_threshold() {
    threshold_node=$1
    threshold_what=$2
    if [ ! -r "$threshold_node" ] || [ ! -w "$threshold_node" ]; then
        die unavailable "$threshold_what is not readable and writable: $threshold_node"
    fi
    threshold_value=$(cat "$threshold_node" 2>/dev/null || echo "")
    case "$threshold_value" in
        ''|*[!0-9]*) die unavailable "$threshold_what is not numeric: $threshold_node" ;;
    esac
}

# The kernel rejects a start value that is not below the end value, so a start
# threshold at or above the requested end is lowered out of the way. See PT-379
# in todo.md: whether that silent change is the right answer is still open.
coerced_start() {
    coerced_old=$1
    coerced_end=$2
    if [ "$coerced_old" -lt "$coerced_end" ]; then
        coerced_start_value=$coerced_old
        return 0
    fi
    coerced_start_value=$((coerced_end - 5))
    if [ "$coerced_start_value" -lt 0 ]; then
        coerced_start_value=0
    fi
}

set_charge_threshold() {
    value=$1
    validate_threshold "$value"

    targets=0
    plan=
    for battery in "$POWER_SUPPLY_DIR"/*; do
        is_battery "$battery" || continue

        end="$battery/charge_control_end_threshold"
        [ -f "$end" ] || continue
        targets=$((targets + 1))

        read_threshold "$end" "charge threshold"
        old_end=$threshold_value

        start="$battery/charge_control_start_threshold"
        if [ -f "$start" ]; then
            read_threshold "$start" "charge start threshold"
            old_start=$threshold_value
            coerced_start "$old_start" "$value"
            if [ "$coerced_start_value" != "$old_start" ]; then
                plan=$(plan_append "$plan" "$start" "$old_start" "$coerced_start_value")
            fi
        fi

        plan=$(plan_append "$plan" "$end" "$old_end" "$value")
    done
    [ "$targets" -gt 0 ] || die unsupported "no battery exposes a charge threshold"

    apply_transaction "$plan"
}

if [ "${1:-}" = protocol-version ]; then
    [ "$#" -eq 1 ] || usage
    printf 'cinnamon-powertoys-helper-protocol %s\n' "$PROTOCOL_VERSION"
    exit 0
fi

[ "$#" -eq 2 ] || usage

acquire_lock

command=$1
argument=$2

case "$command" in
    governor)          set_governor "$argument" ;;
    epp)               set_energy_preference "$argument" ;;
    boost)             set_boost "$argument" ;;
    platform-profile)  set_platform_profile "$argument" ;;
    charge-threshold)  set_charge_threshold "$argument" ;;
    *)                 usage ;;
esac
