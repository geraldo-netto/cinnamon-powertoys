#!/bin/sh
#
# cinnamon-powertoys privileged helper.
#
# Applies the power settings that are owned by root. Every value is checked
# against what the kernel itself advertises, so the applet (or anything else
# calling this through pkexec) cannot write arbitrary data into /sys.
#
# Usage:
#   powertoys-helper governor <name>
#   powertoys-helper epp <name>
#   powertoys-helper boost <0|1>
#   powertoys-helper platform-profile <name>
#   powertoys-helper charge-threshold <20-100>

set -eu

CPU_DIR=/sys/devices/system/cpu
CPUFREQ_DIR=$CPU_DIR/cpufreq
POWER_SUPPLY_DIR=/sys/class/power_supply
PLATFORM_PROFILE=/sys/firmware/acpi/platform_profile
PLATFORM_PROFILE_CHOICES=/sys/firmware/acpi/platform_profile_choices

die() {
    code=$1
    shift
    printf 'powertoys-helper-error %s %s\n' "$code" "$*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage:
  powertoys-helper governor <name>
  powertoys-helper epp <name>
  powertoys-helper boost <0|1>
  powertoys-helper platform-profile <name>
  powertoys-helper charge-threshold <20-100>

Every value is checked against the list the kernel advertises before it is
written. Run through pkexec, the settings are owned by root.
EOF
    echo "powertoys-helper-error invalid-invocation invalid command line" >&2
    exit 2
}

contains() {
    needle=$1
    shift
    for word in "$@"; do
        if [ "$word" = "$needle" ]; then
            return 0
        fi
    done
    return 1
}

first_policy() {
    for policy in "$CPUFREQ_DIR"/policy*; do
        if [ -d "$policy" ]; then
            echo "$policy"
            return 0
        fi
    done
    return 1
}

# write_node <file> <value> <what to say if it will not take it>
#
# A redirect the kernel refuses ends this script under `set -e` with whatever
# the shell chose to say about it - not prefixed, not the same wording from one
# shell to the next, and on some of them not said at all. The applet reports
# the last line of stderr as the reason, so every way this script can fail has
# to be a line this script wrote.
write_node() {
    node=$1
    value=$2
    what=$3
    # the subshell keeps the shell's own message about the redirect quiet
    if ( printf '%s\n' "$value" > "$node" ) 2>/dev/null; then
        return 0
    fi
    die write-failed "$what"
}

try_write() {
    write_target=$1
    write_value=$2
    ( printf '%s\n' "$write_value" > "$write_target" ) 2>/dev/null
}

# write_policies <node name> <value>
write_policies() {
    node=$1
    value=$2
    targets=0
    written=0
    failed=
    for policy in "$CPUFREQ_DIR"/policy*; do
        if [ -f "$policy/$node" ]; then
            targets=$((targets + 1))
            # the subshell keeps a failed redirect quiet
            if ( printf '%s\n' "$value" > "$policy/$node" ) 2>/dev/null; then
                written=$((written + 1))
            else
                failed="${failed}${failed:+, }$policy/$node"
            fi
        fi
    done
    [ "$targets" -gt 0 ] || die unsupported "no cpufreq policy exposes $node"
    [ "$written" -eq "$targets" ] ||
        die write-failed "only $written of $targets policies accepted $node=$value; refused: $failed"
}

set_governor() {
    value=$1
    policy=$(first_policy) || die unavailable "no cpufreq policy found"
    available=$(cat "$policy/scaling_available_governors" 2>/dev/null || echo "")
    [ -n "$available" ] || die unsupported "the scaling driver does not expose governors"
    # shellcheck disable=SC2086
    contains "$value" $available || die invalid-value "unknown governor: $value"
    write_policies scaling_governor "$value"
}

set_energy_preference() {
    value=$1
    policy=$(first_policy) || die unavailable "no cpufreq policy found"
    available=$(cat "$policy/energy_performance_available_preferences" 2>/dev/null || echo "")
    [ -n "$available" ] || die unsupported "the scaling driver does not expose energy preferences"
    # shellcheck disable=SC2086
    contains "$value" $available || die invalid-value "unknown energy preference: $value"
    write_policies energy_performance_preference "$value"
}

set_boost() {
    value=$1
    case "$value" in
        0|1) ;;
        *) die invalid-value "boost expects 0 or 1" ;;
    esac

    if [ -f "$CPUFREQ_DIR/boost" ]; then
        write_node "$CPUFREQ_DIR/boost" "$value" "the kernel would not set boost to $value"
    elif [ -f "$CPU_DIR/intel_pstate/no_turbo" ]; then
        # intel_pstate exposes the inverse switch
        if [ "$value" = "1" ]; then
            inverse=0
        else
            inverse=1
        fi
        write_node "$CPU_DIR/intel_pstate/no_turbo" "$inverse" \
            "the kernel would not set boost to $value"
    else
        die unsupported "this system does not expose a boost switch"
    fi
}

set_platform_profile() {
    value=$1
    [ -f "$PLATFORM_PROFILE" ] || die unsupported "no ACPI platform profile on this system"
    choices=$(cat "$PLATFORM_PROFILE_CHOICES" 2>/dev/null || echo "")
    # shellcheck disable=SC2086
    contains "$value" $choices || die invalid-value "unknown platform profile: $value"
    write_node "$PLATFORM_PROFILE" "$value" "the firmware would not take the profile: $value"
}

set_charge_threshold() {
    value=$1
    case "$value" in
        ''|*[!0-9]*) die invalid-value "charge threshold expects a number" ;;
    esac
    if [ "$value" -lt 20 ] || [ "$value" -gt 100 ]; then
        die invalid-value "charge threshold must be between 20 and 100"
    fi

    targets=0
    plan=
    for battery in "$POWER_SUPPLY_DIR"/*; do
        end="$battery/charge_control_end_threshold"
        [ -f "$end" ] || continue
        targets=$((targets + 1))

        if [ ! -r "$end" ] || [ ! -w "$end" ]; then
            die unavailable "charge threshold is not readable and writable: $end"
        fi
        old_end=$(cat "$end" 2>/dev/null || echo "")
        case "$old_end" in
            ''|*[!0-9]*) die unavailable "charge threshold is not numeric: $end" ;;
        esac

        start="$battery/charge_control_start_threshold"
        old_start=-
        new_start=-
        if [ -f "$start" ]; then
            if [ ! -r "$start" ] || [ ! -w "$start" ]; then
                die unavailable "charge start threshold is not readable and writable: $start"
            fi
            old_start=$(cat "$start" 2>/dev/null || echo "")
            case "$old_start" in
                ''|*[!0-9]*) die unavailable "charge start threshold is not numeric: $start" ;;
            esac
            new_start=$old_start
            # the kernel rejects a start value that is not below the end value
            if [ "$old_start" -ge "$value" ]; then
                new_start=$((value - 5))
                if [ "$new_start" -lt 0 ]; then
                    new_start=0
                fi
            fi
        else
            start=-
        fi

        record="$end	$old_end	$start	$old_start	$new_start"
        if [ -n "$plan" ]; then
            plan="$plan
$record"
        else
            plan=$record
        fi
    done
    [ "$targets" -gt 0 ] || die unsupported "no battery exposes a charge threshold"

    # Apply only after every node has been read and validated. Each completed
    # write is prepended to `applied`, so rollback naturally runs in reverse:
    # an end threshold is restored before the start threshold lowered for it.
    applied=
    failed=
    tab=$(printf '\t')
    while IFS="$tab" read -r end old_end start old_start new_start; do
        if [ "$start" != - ] && [ "$new_start" != "$old_start" ]; then
            if try_write "$start" "$new_start"; then
                record="$start	$old_start"
                applied="$record${applied:+
$applied}"
            else
                failed="$start"
                break
            fi
        fi
        if [ "$old_end" != "$value" ]; then
            if try_write "$end" "$value"; then
                record="$end	$old_end"
                applied="$record${applied:+
$applied}"
            else
                failed="$end"
                break
            fi
        fi
    done <<EOF
$plan
EOF

    [ -z "$failed" ] && return 0

    rollback_failed=
    if [ -n "$applied" ]; then
        while IFS="$tab" read -r node original; do
            if ! try_write "$node" "$original"; then
                rollback_failed="${rollback_failed}${rollback_failed:+, }$node"
            fi
        done <<EOF
$applied
EOF
    fi

    if [ -n "$rollback_failed" ]; then
        die rollback-failed "write refused: $failed; restoration refused: $rollback_failed"
    fi
    die change-failed-restored "write refused: $failed; previous thresholds restored"
}

[ $# -ge 2 ] || usage

command=$1
argument=$2

case "$command" in
    governor)          set_governor "$argument" ;;
    epp)               set_energy_preference "$argument" ;;
    boost)             set_boost "$argument" ;;
    platform-profile)  set_platform_profile "$argument" ;;
    charge-threshold)  set_charge_threshold "$argument" ;;
    *)                 usage ;;
esac
