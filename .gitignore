# Cinnamon Power Toys
#
# This is a GJS/Cinnamon xlet project, not a Node project. Everything that
# belongs in the runtime payload lives in files/cinnamon-powertoys@geraldo-netto/;
# development, packaging and install helpers stay at the top level.

# ---------------------------------------------------------------- build output
build/
dist/
out/
# `make coverage` writes the copies it measures and the lcov here
.coverage/
*.zip
*.tar
*.tar.gz
*.tar.xz
*.tgz
*.deb
*.rpm
*.AppImage

# --------------------------------------------------------------- translations
# .po and .pot files are sources and are committed; compiled catalogues are not
*.mo
*.gmo
messages.mo

# --------------------------------------------------------- generated settings
# Written by Cinnamon at runtime into the user's config, never into the repo,
# but a symlinked or copied install can drop them here
*.gschema.compiled
gschemas.compiled

# ------------------------------------------------------------------- editors
# .vscode/* rather than .vscode/, git cannot re-include a file inside an
# excluded directory
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
.project
.settings/
.classpath
nbproject/
*.sublime-project
*.sublime-workspace
.kdev4/
*.kdev4
.helix/
.nvim.lua
.exrc
.vim/
tags
TAGS
cscope.out

# -------------------------------------------------------------- editor swaps
*~
*.swp
*.swo
*.swn
.*.sw[a-p]
\#*\#
.\#*
.netrwhist

# ------------------------------------------------------- backups and patches
*.bak
*.backup
*.old
*.orig
*.rej
*.save
*.tmp
*.temp
*.original.md

# ----------------------------------------------------------------- operating
# Linux
.directory
.Trash-*
.fuse_hidden*
.nfs*
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------- logs
logs/
*.log
glass.log
xsession-errors*
core
core.*
vgcore.*
*.stackdump

# -------------------------------------------------------------------- python
# for any helper or packaging script added later
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------- optional JS tooling
# only present if a linter or a test runner is added
node_modules/
.npm
.eslintcache
.stylelintcache
package-lock.json.bak

# ------------------------------------------------------------------- secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
secrets.json

# --------------------------------------------------------- local scratch work
scratch/
scratchpad/
tmp/
.tmp/
TODO.local
NOTES.local
*.local.md

# ------------------------------------------------------------- agent tooling
.claude/settings.local.json
.direnv/
